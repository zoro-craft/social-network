    {
      "id": "Y0ACw9S7298-wdTnXAZ2Y",
      "type": "text",
      "x": -322.77746077804454,
      "y": 605.2893462722038,
      "width": 1242.0452880859375,
      "height": 1535.371045861347,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
