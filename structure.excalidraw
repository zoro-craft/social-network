    {
      "id": "Y0ACw9S7298-wdTnXAZ2Y",
      "type": "text",
      "x": -1060.5612661120708,
      "y": 630.3421775486579,
      "width": 1242.0452880859375,
      "height": 1535.371045861347,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
